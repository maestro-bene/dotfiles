# ███████╗██╗███████╗██╗  ██╗
# ██╔════╝██║██╔════╝██║  ██║
# █████╗  ██║███████╗███████║
# ██╔══╝  ██║╚════██║██╔══██║
# ██║     ██║███████║██║  ██║
# ╚═╝     ╚═╝╚══════╝╚═╝  ╚═╝

# Structure:
#   00 — Logging
#   10 — Shared environment
#   20 — Homebrew and static PATH
#   30 — Development tools
#   40 — Shared tool settings
#   50 — Secrets
#   60 — Interactive integrations
#   90 — Debug summary
#
# Custom functions are maintained separately in functions/.
# Mise activation is provided by Homebrew's vendor_conf.d.


# --- 00. Logging ---

if not set -q LOG
    set -g LOG Silent
end

log "🔧 Loading config.fish"


# --- 10. Shared environment ---

set -gx BROWSER firefox

set -gx LANG en_US.UTF-8
set -gx LC_ALL en_US.UTF-8

set -gx LAZYGIT_NEW_DIR_FILE "$HOME/.lazygit/newdir"

# WSLg-specific setting; review before using this file elsewhere.
set -gx XDG_RUNTIME_DIR /mnt/wslg/runtime-dir

# Optional proxy settings.
# set -gx HTTP_PROXY http://localhost:3129
# set -gx HTTPS_PROXY "$HTTP_PROXY"
# set -gx http_proxy "$HTTP_PROXY"
# set -gx https_proxy "$HTTPS_PROXY"

set -gx NO_PROXY "localhost,127.0.0.1,::1"
set -gx no_proxy "$NO_PROXY"


# --- 20. Homebrew and static PATH ---

# Stable destinations for tools installed with "go install".
set -gx GOPATH "$HOME/go"
set -gx GOBIN "$HOME/go/bin"

set -l brew_cmd (command -s brew)

if test -n "$brew_cmd"
    set -gx HOMEBREW_PATH (dirname (dirname "$brew_cmd"))
    set -gx HOMEBREW_NO_ENV_HINTS 1

    log "✅ Homebrew configured: $HOMEBREW_PATH"
else
    log "⚠️ Homebrew not found"
end

# Static PATH priority, highest first:
#   1. Go user-installed tools
#   2. User scripts
#   3. Neovim Mason tools
#   4. Homebrew binaries
#   5. Remaining inherited PATH
#
# Mise manages interpreter paths separately.
# --path avoids storing these entries in universal fish_user_paths.

set -l static_paths \
    "$GOBIN" \
    "$HOME/.local/bin" \
    "$HOME/.local/share/nvim/mason/bin"

if test -n "$brew_cmd"
    set -a static_paths \
        "$HOMEBREW_PATH/bin" \
        "$HOMEBREW_PATH/sbin"
end

fish_add_path --path --move --prepend $static_paths

log "✅ Static PATH configured"


# --- 30. Development tools ---
# Mise:
# Homebrew auto-activation is disabled with the universal variable:
#   set --universal --export MISE_FISH_AUTO_ACTIVATE 0
#
# Explicit interactive activation occurs in section 60,
# after all static PATH modifications.

if command -q mise
    log "✅ Mise executable available"
else
    log "⚠️ Mise not found"
end

# Go:
# Do not derive GOPATH or GOBIN from the selected compiler.
# Both are defined in section 20 before PATH construction.

log "✅ Go destinations configured: GOPATH=$GOPATH, GOBIN=$GOBIN"

# Neovim:
# Resolve the editor after configuring the static PATH.

set -l nvim_cmd (command -s nvim)

if test -n "$nvim_cmd"
    set -gx EDITOR "$nvim_cmd"
    set -gx SUDO_EDITOR "$nvim_cmd"
    set -gx GIT_EDITOR "$nvim_cmd"
    set -gx VISUAL "$nvim_cmd"

    log "✅ Neovim configured as default editor"
else
    log "⚠️ Neovim not found"
end


# --- 40. Shared tool settings ---

# Bat

if command -q bat
    set -gx BAT_THEME "Catppuccin Mocha"
    set -gx MANPAGER "bat -plman"

    log "✅ Bat configured"
end

# Vivid

if command -q vivid
    set -gx LS_COLORS (command vivid generate catppuccin-mocha)

    log "✅ Vivid colors configured"
end

# FZF:
# Keep these variables available to non-interactive commands.

if command -q fzf
    set -gx FZF_DEFAULT_OPTS "\
        --color=spinner:#F5E0DC,hl:#F38BA8 \
        --color=fg:#CDD6F4,header:#F38BA8,info:#CBA6F7,pointer:#F5E0DC \
        --color=marker:#B4BEFE,fg+:#CDD6F4,prompt:#CBA6F7,hl+:#F38BA8 \
        --color=selected-bg:#45475A \
        --color=border:#6C7086,label:#CDD6F4"

    if command -q fd
        set -gx FZF_DEFAULT_COMMAND \
            "fd --type f -H -E '.git' --color=always"

        set -gx FZF_CTRL_T_COMMAND "$FZF_DEFAULT_COMMAND"

        set -gx FZF_CTRL_T_OPTS \
            "--ansi --min-height=30 --preview 'bat --style=numbers --color=always --line-range :300 {}' --preview-window=right,60%,border-left"
    end

    log "✅ FZF variables configured"
end


# --- 50. Secrets ---

# Keep secrets available to non-interactive commands.
# This file is sourced after defaults and can override them.

if test -f "$HOME/.config/fish/secrets.fish"
    source "$HOME/.config/fish/secrets.fish"

    log "✅ secrets.fish loaded"
else
    log "⚠️ secrets.fish not found"
end


# --- 60. Interactive integrations ---

if status is-interactive
    log "🖥️ Initializing interactive shell"

    if command -q tv
        command tv init fish | source
        log "✅ tv integrated"
    else
        log "⚠️ tv not found"
    end

    # --- Mise activation ---
    # Must follow all static PATH modifications.

    if command -q mise
        command mise activate fish | source
        log "✅ Mise activation loaded"
    else
        log "⚠️ Mise not found"
    end

    # --- 61. Interface ---

    set -g fish_greeting ""

    set -g fish_key_bindings fish_vi_key_bindings
    set -g fish_cursor_default block
    set -g fish_cursor_insert line

    fish_config theme choose catppuccin-mocha --color-theme=dark

    log "✅ Fish interface configured"

    # --- 62. SSH / Keychain ---
    # Preserve the existing agent and required-key validation.

{{- if eq .profile "work" }}
    if command -q keychain
        if __ssh_required_keys_loaded
            log "✅ SSH agent ready: both required keys loaded"
        else
            log "🔄 Initializing SSH environment via keychain"

            eval (command keychain --eval --quiet id_ed25519 id_rsa)

            if __ssh_required_keys_loaded
                log "✅ SSH environment ready after keychain"
            else
                log "⚠️ SSH agent unavailable or required keys missing"
            end
        end
    else
        log "⚠️ Keychain not found"
    end
{{- else }}
    # YubiKey GPG/SSH pour fish
    set -gx SSH_AUTH_SOCK (gpgconf --list-dirs agent-ssh-socket | string trim)
    set -gx GPG_TTY (tty)
    gpg-connect-agent updatestartuptty /bye >/dev/null 2>&1

    # Auto-reload GPG agent à chaque nouveau terminal
    function __gpg_reloader --on-variable PWD --description 'Reload gpg agent on PWD change'
      gpg-connect-agent updatestartuptty /bye >/dev/null 2>&1
    end
{{- end}}

    # --- 63. Zoxide ---

    if command -q zoxide
        command zoxide init fish | source

        log "✅ Zoxide integration enabled"
    else
        log "⚠️ Zoxide not found"
    end

    # --- 64. FZF key bindings ---

    if command -q fzf
        command fzf --fish | source

        # Optional bindings provided by the fzf.fish plugin.
        if type -q fzf_configure_bindings
            fzf_configure_bindings \
                --directory=ctrl-f \
                --variables=ctrl-alt-v
        end

        log "✅ FZF integration enabled"
    else
        log "⚠️ FZF not found"
    end

    # --- 65. Package counters ---

    update_brew_cache_async
    update_apt_cache_async

    # --- 66. Starship ---
    # Initialize the prompt after the other interactive integrations.

    if command -q starship
        set -gx STARSHIP_SHELL fish

        command starship init fish | source
        enable_transience

        log "✅ Starship configured"
    else
        log "⚠️ Starship not found"
    end

    # --- 67. Custom interactive scripts ---

    # log_function ~/.config/bin/mount_sshfs
end


# --- 90. Debug summary ---

# External command resolution only.
# Use "type -a COMMAND" to inspect functions and aliases as well.

if test "$LOG" = Log
    log "📊 External commands — startup PATH snapshot:"

    for tool in \
        brew \
        mise python python3 go node rustc cargo \
        nvim \
        bat vivid fzf fd \
        keychain ssh-add \
        zoxide \
        starship

        set -l tool_path (command -s "$tool")

        if test -n "$tool_path"
            log "  ✅ $tool → $tool_path"
        else
            log "  — $tool not found in PATH"
        end
    end

    log "📂 Go installation destinations:"
    log "  GOPATH=$GOPATH"
    log "  GOBIN=$GOBIN"
end

log "🎯 Fish configuration loaded"


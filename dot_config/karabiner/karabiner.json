                ],
                "from": {
                  "key_code": "left_control",
                  "modifiers": { "optional": ["any"] }
                },
                "to": [{ "key_code": "left_command" }],
                "type": "basic"
              }
            ]
          },
          {
            "description": "Internal Keyboard Apple : Caps Lock -> Control (Hold) / Escape (Tap), and Fn + Caps Lock -> true Caps Lock",
            "manipulators": [
              {
                "conditions": [
                  {
                    "identifiers": [{ "is_built_in_keyboard": true }],
                    "type": "device_if"
                  }
                ],
                "from": {
                  "key_code": "caps_lock",
                  "modifiers": { "mandatory": ["fn"] }

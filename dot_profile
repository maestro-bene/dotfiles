# ~/.profile: login-shell PATH and Bash initialization.

if [ -d "$HOME/bin" ]; then
  PATH="$HOME/bin${PATH:+:$PATH}"
fi
if [ -d "$HOME/.local/bin" ]; then
  PATH="$HOME/.local/bin${PATH:+:$PATH}"
fi
export PATH

# Bash does not source .bashrc for login shells by itself.
if [ -n "${BASH_VERSION:-}" ] && [ -r "$HOME/.bashrc" ]; then
  . "$HOME/.bashrc"
fi
